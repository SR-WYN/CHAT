#err_tip[state="normal"] {
  color: green;
}

#err_tip[state="error"] {
  color: red;
}

#pass_visible[state="visible"] {
  border-image: url(:/res/visible.png);
}

#pass_visible[state="visible_hover"] {
  border-image: url(:/res/visible_hover.png);
}

#pass_visible[state="unvisible"] {
  border-image: url(:/res/unvisible.png);
}

#pass_visible[state="unvisible_hover"] {
  border-image: url(:/res/unvisible_hover.png);
}

#confirm_visible[state="visible"] {
  border-image: url(:/res/visible.png);
}

#confirm_visible[state="visible_hover"] {
  border-image: url(:/res/visible_hover.png);
}

#confirm_visible[state="unvisible"] {
  border-image: url(:/res/unvisible.png);
}

#confirm_visible[state="unvisible_hover"] {
  border-image: url(:/res/unvisible_hover.png);
}

#forget_label[state="normal"],
#forget_label[state="selected"] {
  color: black;
}

#forget_label[state="hover"],
#forget_label[state="selected_hover"] {
  color: blue;
}

#side_bar {
  background-color: rgb(46, 46, 46);
}

/* 主窗口背景 */
ChatDialog {
  background-color: #f5f5f5;
}

/* 左侧窄侧边栏 (类似微信最左侧头像图标区) */
#side_bar {
  background-color: #2e2e2e; /* 微信深色侧边栏 */
  min-width: 60px;
}

/* 用户列表区域 (中间联系人列表) */
#chat_user_widget {
  background-color: #ece9e7;
  border-right: 1px solid #dcd9d7;
}

/* 右侧聊天主区域 */
#chat_data_widget {
  background-color: #f5f5f5;
}

/* 搜索框 */
#search_edit {
  background-color: #e2e2e2;
  border: none;
  border-radius: 4px;
  padding: 4px 10px;
  font-size: 12px;
}

/* 加号按钮 */
#add_btn {
  background-color: #e2e2e2;
  border: none;
  border-radius: 4px;
  color: #555555;
  font-weight: bold;
}

/* 联系人列表 */
#chat_user_list,
#search_list {
  background-color: transparent;
  border: none;
  outline: none;
}

#chat_user_list::item:focus {
  border: none;
  outline: none;
}

#chat_user_list::item:selected {
  background-color: #d3d7d4; /* 选中时的浅灰色 */
  border: none;
}

#chat_user_list::item:hover {
  background-color: #cecfd0;
  border: none;
  outline: none;
}

/* 顶部标题栏 */
#title_widget {
  background-color: #f5f5f5;
  border-bottom: 1px solid #e7e7e7;
}

#title_label {
  font-size: 16px;
  font-weight: 500;
  color: #181818;
  padding-left: 15px;
}

/* 工具栏 (表情、文件图标) */
#tool_widget {
  background-color: #f5f5f5;
  border-top: 1px solid #e7e7e7;
}

#emoji_label[state="normal"] {
  border-image: url(:/res/emoji.png);
}

#emoji_label[state="hover"] {
  border-image: url(:/res/emoji_hover.png);
}

#emoji_label[state="press"] {
  border-image: url(:/res/emoji_press.png);
}

#file_label[state="normal"] {
  border-image: url(:/res/filedir.png);
}

#file_label[state="hover"] {
  border-image: url(:/res/filedir_hover.png);
}

#file_label[state="press"] {
  border-image: url(:/res/filedir_press.png);
}

/* 输入框 */
#chat_edit {
  background-color: #f5f5f5;
  border: none;
  font-family: "Microsoft YaHei";
  font-size: 14px;
  padding: 10px;
}

/* 发送按钮 (微信标志性绿色) */
#send_btn {
  background-color: #e9e9e9;
  color: #07c160;
  border: 1px solid #e7e7e7;
  border-radius: 4px;
  padding: 5px 20px;
  font-size: 13px;
}

#send_btn:hover {
  background-color: #d2d2d2;
}

#send_btn:pressed {
  background-color: #c6c6c6;
}

/* 接收按钮/其他功能按钮 */
#receive_btn {
  background-color: #e9e9e9;
  color: #07c160;
  border: 1px solid #e7e7e7;
  border-radius: 4px;
  padding: 5px 20px;
  font-size: 13px;
}

#receive_btn:hover {
  background-color: #d2d2d2;
}

#receive_btn:pressed {
  background-color: #c6c6c6;
}

#add_btn[state="normal"] {
  border-image: url(:/res/add_friend_normal.png);
}

#add_btn[state="hover"] {
  border-image: url(:/res/add_friend_hover.png);
}

#add_btn[state="press"] {
  border-image: url(:/res/add_friend_hover.png);
}

/* 搜索区域的背景容器 */
#search_widget {
  background-color: #f7f7f7;
}

/* 搜索输入框 */
#search_edit {
  background-color: #e2e2e2; /* 浅灰色背景 */
  color: #333333; /* 深色文字 */
  border: 1px solid #e2e2e2; /* 边框与背景同色，防止锯齿 */
}

/* 垂直滚动条 */
QScrollBar:vertical {
  width: 8px;
  background: transparent;
  margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
  background: #c1c1c1;
  border-radius: 4px;
  min-height: 20px;
}

QScrollBar::handle:vertical:hover {
  background: #a8a8a8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0px;
  width: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: none;
}

/* 水平滚动条 */
QScrollBar:horizontal {
  height: 8px;
  background: transparent;
  margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
  background: #c1c1c1;
  border-radius: 4px;
  min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
  background: #a8a8a8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  height: 0px;
  width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: none;
}

/* 聊天数据区域 */
#chat_data_list {
  background-color: #f5f5f5;
}

#chat_background {
  background: #f0f0f0;
}

#chat_area {
  border: none;
}

/* 登录对话框样式优化 */
LoginDialog {
  background-color: #f5f5f5;
}

/* 注册对话框样式优化 */
RegisterDialog {
  background-color: #f5f5f5;
}

/* 重置密码对话框样式优化 */
ResetDialog {
  background-color: #f5f5f5;
}

/* 按钮通用样式 */
QPushButton {
  font-family: "Microsoft YaHei";
  font-size: 14px;
}

/* 标签通用样式 */
QLabel {
  font-family: "Microsoft YaHei";
}

/* 输入框通用样式 */
QLineEdit {
  font-family: "Microsoft YaHei";
  font-size: 14px;
  padding: 5px;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
}

QLineEdit:focus {
  border-color: #07c160;
  outline: none;
}

/* 文本编辑框通用样式 */
QTextEdit {
  font-family: "Microsoft YaHei";
  font-size: 14px;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
}

QTextEdit:focus {
  border-color: #07c160;
  outline: none;
}

/* 列表项样式优化 */
QListWidget::item {
  padding: 10px;
  border-bottom: 1px solid #f0f0f0;
}

QListWidget::item:hover {
  background-color: #f5f5f5;
}

QListWidget::item:selected {
  background-color: #e8f4ea;
  color: #07c160;
}

#chat_user_name {
  color: rgb(153, 153, 153);
  font-size: 14px;
  font-family: "Microsoft YaHei";
}

#side_head_label {
  border-image: url(:/res/head_3.png);
}

#side_chat_label[state="normal"] {
  border-image: url(:/res/chat_icon.png);
}

#side_chat_label[state="hover"] {
  border-image: url(:/res/chat_icon_hover.png);
}

#side_chat_label[state="pressed"] {
  border-image: url(:/res/chat_icon_press.png);
}

#side_chat_label[state="selected_normal"] {
  border-image: url(:/res/chat_icon_press.png);
}

#side_chat_label[state="selected_hover"] {
  border-image: url(:/res/chat_icon_press.png);
}

#side_chat_label[state="selected_pressed"] {
  border-image: url(:/res/chat_icon_press.png);
}

#side_contact_label[state="normal"] {
  border-image: url(:/res/chat_list.png);
}

#side_contact_label[state="hover"] {
  border-image: url(:/res/chat_list_hover.png);
}

#side_contact_label[state="pressed"] {
  border-image: url(:/res/chat_list_press.png);
}

#side_contact_label[state="selected_normal"] {
  border-image: url(:/res/chat_list_press.png);
}

#side_contact_label[state="selected_hover"] {
  border-image: url(:/res/chat_list_press.png);
}

#side_contact_label[state="selected_pressed"] {
  border-image: url(:/res/chat_list_press.png);
}

#search_edit {
  border: 2px solid #f1f1f1;
}

/* 搜索框列表*/
#search_list {
  background-color: rgb(247, 247, 248);
  border: none;
}

#search_list::item:selected {
  background-color: #d3d7d4;
  border: none;
  outline: none;
}

#search_list::item:hover {
  background-color: rgb(206, 207, 208);
  border: none;
  outline: none;
}

#search_list::focus {
  border: none;
  outline: none;
}

#invalid_item {
  background-color: #eaeaea;
  border: none;
}

#add_tip {
  border-image: url(:/res/add_tip.png);
}

#right_tip {
  border-image: url(:/res/arrow_right.png);
}

#message_tip {
  text-align: center;
  font-family: "Microsoft YaHei";
  font-size: 12pt;
}

#FindSuccessDialog {
  background-color: #ffffff;
}

#name_label {
  font-size: 14px;
  font-family: "Microsoft YaHei";
}

#add_friend_btn[state="normal"] {
  background: #07c160;
  color: #ffffff;
  font-size: 14px;
  font-family: "Microsoft YaHei";
  border-radius: 20px;
}
