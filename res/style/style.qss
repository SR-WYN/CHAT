#err_tip[state="normal"] {
  color: green;
}

#err_tip[state="error"] {
  color: red;
}

#pass_visible[state="visible"] {
  border-image: url(:/res/visible.png);
}

#pass_visible[state="visible_hover"] {
  border-image: url(:/res/visible_hover.png);
}

#pass_visible[state="unvisible"] {
  border-image: url(:/res/unvisible.png);
}

#pass_visible[state="unvisible_hover"] {
  border-image: url(:/res/unvisible_hover.png);
}

#confirm_visible[state="visible"] {
  border-image: url(:/res/visible.png);
}

#confirm_visible[state="visible_hover"] {
  border-image: url(:/res/visible_hover.png);
}

#confirm_visible[state="unvisible"] {
  border-image: url(:/res/unvisible.png);
}

#confirm_visible[state="unvisible_hover"] {
  border-image: url(:/res/unvisible_hover.png);
}

#forget_label[state="normal"],
#forget_label[state="selected"] {
  color: black;
}

#forget_label[state="hover"],
#forget_label[state="selected_hover"] {
  color: blue;
}

#side_bar {
  background-color: rgb(46, 46, 46);
}

/* 主窗口背景 */
ChatDialog {
  background-color: #f5f5f5;
}

/* 左侧窄侧边栏 (类似微信最左侧头像图标区) */
#side_bar {
  background-color: #2e2e2e; /* 微信深色侧边栏 */
  min-width: 60px;
}

/* 用户列表区域 (中间联系人列表) */
#chat_user_widget {
  background-color: #ece9e7;
  border-right: 1px solid #dcd9d7;
}

/* 右侧聊天主区域 */
#chat_data_widget {
  background-color: #f5f5f5;
}

#side_head_label {
  margin-top: 20px;
  margin-bottom: 20px;
  border-radius: 4px;
}

#side_chat_label,
#side_contact_label {
  padding: 10px;
  color: #919191;
}

#side_chat_label:hover,
#side_contact_label:hover {
  color: #07c160; /* 微信绿 */
}

/* 搜索框 */
#search_edit {
  background-color: #e2e2e2;
  border: none;
  border-radius: 4px;
  padding: 4px 10px;
  font-size: 12px;
}

/* 加号按钮 */
#add_btn {
  background-color: #e2e2e2;
  border: none;
  border-radius: 4px;
  color: #555555;
  font-weight: bold;
}

/* 联系人列表 */
#chat_user_list,
#search_list {
  background-color: transparent;
  border: none;
  outline: none;
}

#chat_user_list::item {
  height: 64px;
  padding-left: 10px;
}

#chat_user_list::item:selected {
  background-color: #c7c6c5; /* 选中时的浅灰色 */
  border: none;
}

#chat_user_list::item:hover {
  background-color: #d9d8d7;
}

/* 顶部标题栏 */
#title_widget {
  background-color: #f5f5f5;
  border-bottom: 1px solid #e7e7e7;
}

#title_label {
  font-size: 16px;
  font-weight: 500;
  color: #181818;
  padding-left: 15px;
}

/* 工具栏 (表情、文件图标) */
#tool_widget {
  background-color: #f5f5f5;
  border-top: 1px solid #e7e7e7;
}

#emoji_label,
#file_label {
  padding: 5px;
  margin-left: 10px;
}

/* 输入框 */
#chat_edit {
  background-color: #f5f5f5;
  border: none;
  font-family: "Microsoft YaHei";
  font-size: 14px;
  padding: 10px;
}

/* 发送按钮 (微信标志性绿色) */
#send_btn {
  background-color: #e9e9e9;
  color: #07c160;
  border: 1px solid #e7e7e7;
  border-radius: 4px;
  padding: 5px 20px;
  font-size: 13px;
}

#send_btn:hover {
  background-color: #d2d2d2;
}

#send_btn:pressed {
  background-color: #c6c6c6;
}

/* 接收按钮/其他功能按钮 */
#receive_btn {
  background-color: #e9e9e9;
  color: #07c160;
  border: 1px solid #e7e7e7;
  border-radius: 4px;
  padding: 5px 20px;
  font-size: 13px;
}

#receive_btn:hover {
  background-color: #d2d2d2;
}

#receive_btn:pressed {
  background-color: #c6c6c6;
}

#add_btn[state="normal"] {
  border-image: url(:/res/add_friend_normal.png);
}

#add_btn[state="hover"] {
  border-image: url(:/res/add_friend_hover.png);
}

#add_btn[state="press"] {
  border-image: url(:/res/add_friend_hover.png);
}
